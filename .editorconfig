# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Las páginas HTML contienen imágenes base64 en líneas muy largas: no reformatear.
[*.html]
max_line_length = off
